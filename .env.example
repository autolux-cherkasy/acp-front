# Copy to .env.local for local dev. See docker-compose subtask for container wiring.
#
# Next.js bakes NEXT_PUBLIC_* vars into the client bundle at `next build` time —
# they cannot be changed later via container env, only by rebuilding the image
# (Docker: --build-arg). Everything else below is read at container start
# (Docker: plain container env), same as the backend.

# ---- Build-time (baked into the client bundle) ----

# Base path/URL the browser calls for API requests. Left relative ("/api/v1")
# when the backend is reverse-proxied through this app on the same origin (see
# API_PROXY_TARGET below) — set to a real absolute URL only if the frontend
# talks to the backend cross-origin instead.
NEXT_PUBLIC_API_URL=/api/v1

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Exposes window.__devAuth, a role-spoofing auth bypass for local dev. Must be
# "false" (or unset) for any build that gets deployed — enforced at build time
# by scripts/assert-prod-env.mjs, which fails the build if this is "true".
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Runtime (server-side only, not exposed to the browser) ----

# Backend origin this app proxies /api/v1/* and /uploads/* to (next.config.ts
# rewrites) and falls back to when resolving a relative NEXT_PUBLIC_API_URL
# during server-side rendering. Docker: the backend service's internal DNS
# name on the shared network, e.g. http://backend:3001.
API_PROXY_TARGET=http://localhost:3001

# Server-side Google OAuth client id, used by app/api/google-auth/config.
# Falls back to NEXT_PUBLIC_GOOGLE_CLIENT_ID if unset.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
